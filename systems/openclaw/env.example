# Copy this file to .env and fill only the providers needed for a run.
# Do not commit real credentials.

# OpenAI-compatible endpoint for Qwen chat, if using DashScope-compatible mode.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# OpenRouter endpoint for Qwen-235B chat runs.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_API_KEY2=

# Generic OpenAI-compatible endpoint for embeddings and judge.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional aliases used by the runner.
GPT_BASE_URL=
GPT_API_KEY=
OTHER_BASE_URL=
OTHER_API_KEY=
